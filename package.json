{
  "name": "estude-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:student",
    "dev:admin": "cross-env NEXT_PUBLIC_AUTH_PORTAL=admin next dev",
    "dev:teacher": "cross-env NEXT_PUBLIC_AUTH_PORTAL=teacher next dev",
    "dev:student": "cross-env NEXT_PUBLIC_AUTH_PORTAL=student next dev",
    "dev:parent": "cross-env NEXT_PUBLIC_AUTH_PORTAL=parent next dev",
    "serve": "npm run serve:all",
    "serve:all": "concurrently --kill-others --names APP,ROLES --prefix-colors blue,magenta \"npm:serve:admin\" \"npm:serve:roles\"",
    "serve:admin": "cross-env ESTUDE_APP_ROLE=ADMIN NEXT_DIST_DIR=.next-admin next dev -p 3000",
    "serve:teacher": "cross-env ESTUDE_APP_ROLE=TEACHER NEXT_DIST_DIR=.next-teacher next dev -p 3001",
    "serve:student": "cross-env ESTUDE_APP_ROLE=STUDENT NEXT_DIST_DIR=.next-student next dev -p 3002",
    "serve:parent": "cross-env ESTUDE_APP_ROLE=PARENT NEXT_DIST_DIR=.next-parent next dev -p 3003",
    "serve:roles": "node scripts/serve-role-proxies.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.21",
    "http-proxy": "^1.18.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
